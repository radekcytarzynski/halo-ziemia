# Domyślne wartości zmiennych środowiskowych (commitowane, BEZ sekretów).
# Lokalne/produkcyjne nadpisania: .env.local (poza repo).
# Kolejność: .env < .env.local < .env.$APP_ENV < .env.$APP_ENV.local < prawdziwe zmienne środowiskowe.

###> symfony/framework-bundle ###
APP_ENV=dev
# Wygeneruj: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# Publiczny adres panelu (linki w mailach generowanych z crona).
APP_BASE_URL=http://localhost:8090
DEFAULT_URI=${APP_BASE_URL}

# Strefa czasowa prezentacji w UI i mailach (w bazie zawsze UTC).
APP_TIMEZONE_DISPLAY=Europe/Warsaw

# Opcjonalny URL pingowany po każdym udanym app:tick (np. healthchecks.io). Pusty = wyłączony.
WATCHDOG_URL=

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailer:1025
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://halo:halo@db:3306/halo?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
