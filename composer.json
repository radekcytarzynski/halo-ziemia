{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.8",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/extra-bundle": "^3.29",
        "twig/string-extra": "^3.24"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.8",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "process-timeout": 0
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --ansi",
        "cs-fix": "php-cs-fixer fix --ansi",
        "stan": [
            "@php bin/console cache:warmup --env=dev --quiet",
            "phpstan analyse --memory-limit=1G --no-progress --ansi"
        ],
        "test-db": [
            "@php bin/console doctrine:database:create --if-not-exists --env=test --quiet",
            "@php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration --env=test --quiet"
        ],
        "test": [
            "@test-db",
            "phpunit"
        ],
        "qa": [
            "@cs",
            "@stan",
            "@test",
            "@agent"
        ],
        "agent": [
            "shellcheck -x agent/halo-ziemia-agent agent/lib/collect.sh agent/install.sh agent/uninstall.sh agent/tests/helper.bash agent/tests/stubs/*",
            "shellcheck -s bash agent/checks.d/backup.sh.example",
            "bats agent/tests"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "require": "7.4.*",
            "docker": "false"
        }
    },
    "description": "halo-ziemia: monitoring urządzeń (heartbeat + metryki) z alarmami e-mail",
    "name": "halo-ziemia/app",
    "scripts-descriptions": {
        "qa": "cs-fixer (dry-run) + phpstan + phpunit + testy agenta",
        "cs": "Sprawdzenie stylu kodu",
        "cs-fix": "Poprawa stylu kodu",
        "stan": "PHPStan level max",
        "test": "Testy PHPUnit (przygotowuje bazę testową)",
        "test-db": "Tworzy i migruje bazę testową",
        "agent": "Agent: shellcheck + testy bats"
    }
}
