# Szablon pliku shared/.env.local na serwerze (~/domains/<domena>/shared/.env.local, chmod 600).
# deploy.sh kopiuje go przy każdym wdrożeniu do app/.env.local. Nadpisuje wartości z .env z paczki,
# więc musi zawierać WSZYSTKIE sekrety – .env w repo ma tylko wartości deweloperskie.
# Wartości w <...> uzupełnij; tego pliku z prawdziwymi danymi nie commituj.

# Środowisko Symfony: prod = cache konfiguracji, brak profilera i stron błędów z trace'ami.
APP_ENV=prod
APP_DEBUG=0

# Sekret (CSRF, podpisy). Wygeneruj NA SERWERZE: openssl rand -hex 32
APP_SECRET=<losowe-64-znaki-hex>

# Publiczny adres panelu (bez ukośnika na końcu). Host musi być równy nazwie katalogu domeny.
# Z niego budowane są linki w mailach generowanych przez cron.
APP_BASE_URL=https://<domena>

# Baza z panelu hostingu (MySQL Management). serverVersion = wynik SELECT VERSION(); (np. 10.11.14-MariaDB).
# Znaki specjalne w haśle zakoduj URL-owo (@ → %40, # → %23, / → %2F).
DATABASE_URL="mysql://<uzytkownik_db>:<haslo_db>@localhost:3306/<nazwa_db>?serverVersion=<wersja>-MariaDB&charset=utf8mb4"

# Wysyłka powiadomień. Skrzynka z panelu hostingu, SMTP z SSL na 465 (login = pełny adres, @ jako %40):
#   smtp://<adres%40domena.pl>:<haslo>@<serwer-smtp>:465
MAILER_DSN=smtp://<adres%40domena.pl>:<haslo>@<serwer-smtp>:465
# Nadawca – najlepiej ta sama skrzynka co w MAILER_DSN (inaczej SPF/DMARC mogą odrzucić maile).
MAILER_FROM=<monitor@domena.pl>

# API agentów tylko po HTTPS (zostaw 1).
API_REQUIRE_HTTPS=1

# Opcjonalnie: URL pingowany po każdym udanym app:tick (np. https://hc-ping.com/<uuid>).
# Gdy cron przestanie działać, zewnętrzna usługa wyśle alarm.
WATCHDOG_URL=

# Opcjonalnie: jeśli /health pokazuje "secure":false mimo HTTPS (aplikacja za reverse proxy),
# podaj adresy proxy, np. TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
#TRUSTED_PROXIES=

# Ścieżka PHP CLI na hostingu (tylko do podpowiedzi wpisów crona w panelu → Ustawienia).
PHP_CLI=/usr/local/bin/php85

# Strefa czasowa prezentacji (w bazie zawsze UTC).
APP_TIMEZONE_DISPLAY=Europe/Warsaw
