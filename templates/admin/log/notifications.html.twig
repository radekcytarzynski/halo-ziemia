{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Powiadomienia{% endblock %}

{% block content %}
    <div class="page-head"><h1>Dziennik</h1></div>
    {{ include('admin/log/_tabs.html.twig', {active: 'notifications'}) }}

    <form method="get" class="filters card">
        <label>Status
            <select name="status">
                <option value="">wszystkie</option>
                {% for s in statuses %}<option value="{{ s.value }}"{% if filter.status == s.value %} selected{% endif %}>{{ s.value }}</option>{% endfor %}
            </select>
        </label>
        <button type="submit" class="btn btn-sm">Filtruj</button>
    </form>

    <p class="muted small">{{ total }} wiadomości</p>
    {% if messages is empty %}
        <p class="muted">Brak powiadomień.</p>
    {% else %}
        <div class="table-wrap card card-flush">
            <table class="table table-compact">
                <thead><tr><th>Utworzono</th><th>Temat</th><th>Odbiorca</th><th>Status</th><th class="hide-sm">Próby</th><th></th></tr></thead>
                <tbody>
                {% for m in messages %}
                    <tr>
                        <td class="small">{{ m.createdAt|date('Y-m-d H:i') }}</td>
                        <td>{{ m.subject }}{% if m.lastError %}<br><span class="error-text small">{{ m.lastError|u.truncate(160, '…') }}</span>{% endif %}</td>
                        <td class="small">{{ m.address }}</td>
                        <td>
                            {% if m.status.value == 'sent' %}<span class="tag tag-ok">wysłano {{ m.sentAt|date('H:i') }}</span>
                            {% elseif m.status.value == 'failed' %}<span class="tag tag-crit">porzucono</span>
                            {% else %}<span class="tag tag-muted">w kolejce{% if m.attempts > 0 %}, następna {{ m.nextAttemptAt|date('H:i') }}{% endif %}</span>{% endif %}
                        </td>
                        <td class="hide-sm num">{{ m.attempts }}</td>
                        <td class="actions">
                            {% if m.status.value == 'failed' %}{{ ui.post_button(path('app_log_notification_retry', {id: m.id}), 'outbox' ~ m.id, 'Ponów') }}{% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    {{ ui.pagination('app_log_notifications', filter|filter(v => v is not null), page, pages) }}
{% endblock %}
