{% extends 'base.html.twig' %}

{% block title %}Ustawienia{% endblock %}

{% block content %}
    <div class="page-head"><h1>Ustawienia</h1></div>

    <div class="grid-2">
        {{ form_start(form, {attr: {class: 'form card', novalidate: 'novalidate'}}) }}
            <h2>Alarmy i powiadomienia</h2>
            {{ form_row(form.missed_intervals_threshold) }}
            {{ form_row(form.reminder_interval_hours) }}
            {{ form_row(form.mail_from, {attr: {placeholder: mail_from_effective}}) }}
            {{ form_row(form.mail_from_name) }}
            <h2>Retencja danych</h2>
            {{ form_row(form.retention_raw_days, {help: 'Próbki co minutę – wykresy 24 h i 7 dni (starsze okresy z rollupów). Największa część bazy: ok. 4–5 MB na urządzenie na dobę (przy ~45 metrykach).'}) }}
            {{ form_row(form.retention_rollup_days, {help: 'Agregaty godzinne (wykresy 30 dni i rok) oraz dziennik zdarzeń.'}) }}
            <div class="form-actions"><button type="submit" class="btn btn-primary">Zapisz</button></div>
        {{ form_end(form) }}

        <section class="card">
            <h2>Cron</h2>
            {% if cron.stale %}
                <div class="banner banner-crit">{% if cron.last_tick_at %}Ostatni <code>app:tick</code> {{ cron.last_tick_at|hz_ago }} – cron nie działa.{% else %}<code>app:tick</code> jeszcze się nie wykonał.{% endif %}</div>
            {% else %}
                <p><span class="status status-ok">OK</span> ostatni <code>app:tick</code> {{ cron.last_tick_at|hz_ago }}</p>
            {% endif %}
            <p class="muted small">Wpisy crona w panelu hostingu (ścieżkę dostosuj do katalogu wydania):</p>
            <div class="snippet">
                <pre id="cron-lines"><code>* * * * * {{ php_cli }} {{ project_dir }}/bin/console app:tick --no-interaction &gt;/dev/null 2&gt;&amp;1
5 * * * * {{ php_cli }} {{ project_dir }}/bin/console app:rollup --no-interaction &gt;/dev/null 2&gt;&amp;1
30 3 * * * {{ php_cli }} {{ project_dir }}/bin/console app:retention --no-interaction &gt;/dev/null 2&gt;&amp;1</code></pre>
                <button type="button" class="btn btn-sm copy-btn" data-copy-target="cron-lines">Kopiuj</button>
            </div>

            <h2 class="mt">Rollup i retencja</h2>
            {% set until = storage.rollupUntil %}
            {% set retention = storage.lastRetentionAt %}
            {% if storage.rollupStale or storage.retentionStale %}
                <div class="banner banner-warn">Rollup albo retencja nie są uruchamiane – baza będzie rosła bez ograniczeń. Dodaj do crona <code>app:rollup</code> i <code>app:retention</code> (wyżej).</div>
            {% endif %}
            <dl class="kv">
                <dt>Rollup godzinny</dt>
                <dd>{% if until %}dane do {{ until|date('Y-m-d H:i') }}{% else %}<span class="muted">jeszcze nie działał</span>{% endif %}</dd>
                <dt>Retencja</dt>
                <dd>{% if retention %}{{ retention|hz_ago }}{% else %}<span class="muted">jeszcze nie działała</span>{% endif %}</dd>
            </dl>

            <h2 class="mt">Rozmiar danych</h2>
            <div class="table-wrap">
                <table class="table table-compact">
                    <thead><tr><th>Tabela</th><th class="num">Wiersze (ok.)</th><th class="num">Rozmiar</th></tr></thead>
                    <tbody>
                    {% for t in tables|filter(t => t.bytes >= 1048576)|slice(0, 6) %}
                        <tr><td class="mono small">{{ t.name }}</td><td class="num">{{ t.rows|hz_number }}</td><td class="num">{{ t.bytes|hz_bytes }}{% if t.free >= 10485760 %} <span class="muted small" title="Miejsce po usuniętych danych, do odzyskania: app:retention --optimize">+{{ t.free|hz_bytes }} wolne</span>{% endif %}</td></tr>
                    {% endfor %}
                    <tr><td><strong>Razem</strong></td><td></td><td class="num"><strong>{{ tables|reduce((sum, t) => sum + t.bytes, 0)|hz_bytes }}</strong></td></tr>
                    </tbody>
                </table>
            </div>

            <h2 class="mt">Watchdog</h2>
            <p>{% if watchdog_configured %}<span class="status status-ok">włączony</span> Po każdym udanym ticku wysyłany jest ping do <code>WATCHDOG_URL</code>.{% else %}<span class="status status-pending">wyłączony</span> Ustaw <code>WATCHDOG_URL</code> (np. healthchecks.io), aby dostać alarm, gdy przestanie działać sam monitor.{% endif %}</p>

            <h2 class="mt">Nadawca</h2>
            <p class="small">Maile wychodzą z adresu <code>{{ mail_from_effective }}</code>. Przetestuj wysyłkę na stronie odbiorcy.</p>
        </section>
    </div>
{% endblock %}
