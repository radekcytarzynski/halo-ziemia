{% extends 'base.html.twig' %}

{% block title %}Pulpit{% endblock %}

{% block importmap %}{{ importmap(['app', 'dashboard'], {nonce: csp_nonce()}) }}{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Pulpit</h1>
        <div class="page-actions">
            <span class="muted small refresh-note" data-refresh-note>Odświeżanie co 15 s</span>
            <a class="btn btn-sm" href="{{ path('app_device_new') }}">+ Urządzenie</a>
        </div>
    </div>

    <div id="dashboard" data-refresh-url="{{ path('app_dashboard_cards') }}" data-refresh-seconds="15" aria-live="polite">
        {{ include('admin/_dashboard_cards.html.twig') }}
    </div>
{% endblock %}
